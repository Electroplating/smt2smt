    // ...
}

void quasiToBasic(ArithVar v) {
    Assert(isQuasiBasic(v));
    // 重建行和列索引
    // ...
    d_varTypes[v] = VarType::BASIC;
}
```

8.2 最短多项式选择示例
-----------------------

【OpenSMT 实现模式】

```cpp
LVRef Simplex::getBasicVarToFixByShortestPoly() const {
    LVRef current = LVRef::Undef;
    std::size_t current_poly_size = std::numeric_limits<std::size_t>::max();
    for (auto it : candidates) {
        bool const doUpdate = tableau.getPolySize(it) < current_poly_size;
        if (doUpdate) {
            current = it;
            current_poly_size = tableau.getPolySize(it);
        }
    }
    return current;
}
```

【cvc5 迁移建议模式】

```cpp
// 在 ErrorSet 的 ComparatorPivotRule 中添加
bool operator()(ArithVar v, ArithVar u) const {
    if (d_rule == ErrorSelectionRule::SHORTEST_POLY) {
        std::size_t size_v = d_tableau->getRowSize(v);
        std::size_t size_u = d_tableau->getRowSize(u);
        return size_v < size_u || (size_v == size_u && v < u);
    }
    // ... 其他规则
}

// 在 Tableau 中添加
std::size_t getRowSize(ArithVar basic) const {
    RowIndex rid = basicToRowIndex(basic);
    return getRow(rid).getRowLength();  // 返回非零项数量
}
```

8.3 列长度启发式示例
---------------------

【OpenSMT 实现模式】

```cpp
LVRef Simplex::findNonBasicForPivotByHeuristic(LVRef basicVar) {
    LVRef v_found = LVRef::Undef;
    for (auto const & term : tableau.getRowPoly(basicVar)) {
        auto var = term.var;
        if (/* 满足转轴条件 */) {
            if (v_found == LVRef::Undef) {
                v_found = var;
            }
            // 启发式: 选择列长度最短的变量
            else if (tableau.getColumn(v_found).size() > 
                     tableau.getColumn(var).size()) {
                v_found = var;
            }
        }
    }
    return v_found;
}
```

【cvc5 迁移建议模式】

```cpp
// 在 LinearEqualityModule::selectSlack() 中增强
ArithVar selectSlack(ArithVar x_i, VarPreferenceFunction pf) const {
    ArithVar best = ARITHVAR_SENTINEL;
    std::size_t best_col_length = std::numeric_limits<std::size_t>::max();
    
    for (/* 遍历行中的非基变量 */) {
        if (/* 满足转轴条件 */) {
            std::size_t col_length = d_tableau.getColumnLength(nb);
            if (best == ARITHVAR_SENTINEL || col_length < best_col_length) {
                best = nb;
                best_col_length = col_length;
            }
        }
    }
    return best;
}
```

8.4 边界激活缓冲区示例
-----------------------

【OpenSMT 实现模式】

```cpp
// 边界断言时缓冲
Explanation Simplex::assertBound(LABoundRef boundRef) {
    LVRef boundTerm = boundStore[boundRef].getLVRef();
    // ... 检查冲突 ...
    bufferOfActivatedBounds.emplace_back(boundTerm, boundRef);
    return Explanation();
}

// 批量处理缓冲区
void Simplex::processBufferOfActivatedBounds() {
    while (!bufferOfActivatedBounds.empty()) {
        LVRef var = bufferOfActivatedBounds.back().first;
        LABoundRef boundRef = bufferOfActivatedBounds.back().second;
        bufferOfActivatedBounds.pop_back();
        
        if (tableau.isNonBasic(var)) {
            // 更新非基变量值
            auto const & bound = boundStore[boundRef];
            if (!isBoundSatisfied(model->read(var), bound)) {
                changeValueBy(var, bound.getValue() - model->read(var));
            }
        } else {
            // 基变量: 检查是否出界，加入候选
            if (isModelOutOfBounds(var)) {
                newCandidate(var);
            }
        }
    }
}
```

