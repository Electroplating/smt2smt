8.1 准基变量转换示例
---------------------

【OpenSMT 实现模式】

```cpp
// Tableau::basicToQuasi() - 基变量转准基变量
void Tableau::basicToQuasi(LVRef v) {
    assert(isBasic(v));
    varTypes[getVarId(v)] = VarType::QUASIBASIC;
    Polynomial & row = getRowPoly(v);
    for (auto & term : row) {
        assert(isNonBasic(term.var));
        removeRowFromColumn(v, term.var);  // 从列索引中移除
    }
}

// Tableau::quasiToBasic() - 准基变量转基变量
void Tableau::quasiToBasic(LVRef v) {
    assert(isQuasiBasic(v));
    normalizeRow(v);  // 规范化行，消除基本变量
    for (auto const & term : getRowPoly(v)) {
        addRowToColumn(v, term.var);  // 重建列索引
    }
    varTypes[getVarId(v)] = VarType::BASIC;
}

// Simplex::boundActivated() - 边界激活处理
void Simplex::boundActivated(LVRef v) {
    if (tableau.isQuasiBasic(v)) { 
        quasiToBasic(v);  // 需要时转换为基变量
    }
    ++boundsActivated[getVarId(v)];
}
```

【cvc5 迁移建议模式】

